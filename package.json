{
  "name": "@flashcards/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "build:1x1": "pnpm --filter 1x1 build",
    "build:div": "pnpm --filter div build",
    "build:eta": "pnpm --filter eta build",
    "build:lwk": "pnpm --filter lwk build",
    "build:pum": "pnpm --filter pum build",
    "build:voc": "pnpm --filter voc build",
    "build": "pnpm --filter \"./apps/*\" build",
    "clean:cache": "rm -rf .cache apps/*/.cache packages/*/.cache coverage apps/*/coverage packages/*/coverage",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist",
    "cy:open:1x1": "pnpm --filter 1x1 cy:open --browser chrome",
    "cy:open:div": "pnpm --filter div cy:open --browser chrome",
    "cy:open:eta": "pnpm --filter eta cy:open --browser chrome",
    "cy:open:lwk": "pnpm --filter lwk cy:open --browser chrome",
    "cy:open:pum": "pnpm --filter pum cy:open --browser chrome",
    "cy:open:voc": "pnpm --filter voc cy:open --browser chrome",
    "cy:run:1x1": "pnpm --filter 1x1 cy:run --browser chrome",
    "cy:run:div": "pnpm --filter div cy:run --browser chrome",
    "cy:run:eta": "pnpm --filter eta cy:run --browser chrome",
    "cy:run:lwk": "pnpm --filter lwk cy:run --browser chrome",
    "cy:run:pum": "pnpm --filter pum cy:run --browser chrome",
    "cy:run:voc": "pnpm --filter voc cy:run --browser chrome",
    "cy:run": "pnpm --filter \"./apps/*\" --parallel cy:run",
    "dev:1x1": "pnpm --filter 1x1 dev",
    "dev:div": "pnpm --filter div dev",
    "dev:eta": "pnpm --filter eta dev",
    "dev:lwk": "pnpm --filter lwk dev",
    "dev:pum": "pnpm --filter pum dev",
    "dev:voc": "pnpm --filter voc dev",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "find-unused": "node ./scripts/find-unused.js",
    "preview": "pnpm --filter \"./apps/*\" --parallel preview",
    "preview:1x1": "pnpm --filter 1x1 preview",
    "preview:div": "pnpm --filter div preview",
    "preview:eta": "pnpm --filter eta preview",
    "preview:lwk": "pnpm --filter lwk preview",
    "preview:pum": "pnpm --filter pum preview",
    "preview:voc": "pnpm --filter voc preview",
    "pw:open:1x1": "pnpm --filter 1x1 pw:open",
    "pw:open:div": "pnpm --filter div pw:open",
    "pw:open:eta": "pnpm --filter eta pw:open",
    "pw:open:lwk": "pnpm --filter lwk pw:open",
    "pw:open:pum": "pnpm --filter pum pw:open",
    "pw:open:voc": "pnpm --filter voc pw:open",
    "pw:run:1x1": "pnpm --filter 1x1 pw:run",
    "pw:run:div": "pnpm --filter div pw:run",
    "pw:run:eta": "pnpm --filter eta pw:run",
    "pw:run:lwk": "pnpm --filter lwk pw:run",
    "pw:run:pum": "pnpm --filter pum pw:run",
    "pw:run:voc": "pnpm --filter voc pw:run",
    "pw:run": "pnpm --filter \"./apps/*\" --parallel pw:run",
    "test:cov": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test:cov",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "types": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" types",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^26.6.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "cypress": "^16.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "sass": "^1.104.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
